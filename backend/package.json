{
  "name": "lunalearn-backend",
  "version": "0.1.0",
  "description": "LunaLearn academic backend, database schema, and Supabase integration",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:connection": "tsx src/scripts/test-connection.ts",
    "seed": "tsx src/scripts/seed-demo.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "test:auth": "tsx src/scripts/test-auth.ts",
    "test:crud": "tsx src/scripts/test-crud.ts",
    "test:engine": "tsx src/scripts/test-engine.ts",
    "test:planner": "tsx src/scripts/test-planner.ts",
    "test:rag": "tsx src/scripts/test-rag-phase1.ts",
    "test:rag2": "tsx src/scripts/test-rag-phase2.ts",
    "test:assistant": "tsx src/scripts/test-assistant-phase3.ts",
    "test:quiz": "tsx src/scripts/test-quiz-phase4.ts",
    "test:reactive": "tsx src/scripts/test-real-data.ts",
    "test": "tsx src/scripts/test-auth.ts && tsx src/scripts/test-crud.ts && tsx src/scripts/test-engine.ts && tsx src/scripts/test-planner.ts && tsx src/scripts/test-e2e-loop.ts && tsx src/scripts/test-rag-phase1.ts && tsx src/scripts/test-rag-phase2.ts && tsx src/scripts/test-assistant-phase3.ts && tsx src/scripts/test-quiz-phase4.ts && tsx src/scripts/test-real-data.ts"
  },

  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "busboy": "^1.6.0",
    "dotenv": "^16.4.5",
    "pdf-parse": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^20.14.10",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
