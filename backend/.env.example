# LunaLearn Supabase Connection Settings
# Get these from your Supabase Project Settings -> API (https://supabase.com/dashboard/project/_/settings/api)

# Supabase Project REST API URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (safe for client queries with RLS)
SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Key (secret, elevated permissions for backend administration)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: Direct PostgreSQL connection string (Project Settings -> Database)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Google Gemini API Settings (AI/RAG Track Phases 1-6)
# Get your API key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Optional: Override recommended embedding model (defaults to 'gemini-embedding-001')
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

