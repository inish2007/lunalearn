{
  "name": "lunalearn-backend",
  "version": "0.1.0",
  "description": "LunaLearn academic backend, database schema, and Supabase integration",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:connection": "tsx src/scripts/test-connection.ts",
    "test:auth": "tsx src/scripts/test-auth.ts",
    "test:crud": "tsx src/scripts/test-crud.ts",
    "test": "tsx src/scripts/test-auth.ts && tsx src/scripts/test-crud.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
